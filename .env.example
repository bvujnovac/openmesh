# Application
APP_NAME=OpenMesh
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-random-string
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database - SQLite (default) or PostgreSQL
# SQLite (recommended for most deployments):
DATABASE_URL=sqlite+aiosqlite:///./openmesh.db
# PostgreSQL (if needed for larger deployments):
# DATABASE_URL=postgresql+asyncpg://openmesh:openmesh@postgres:5432/openmesh
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# InfluxDB (for metrics storage)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=openmesh-dev-token-change-in-production
INFLUXDB_ORG=openmesh
INFLUXDB_BUCKET=metrics

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Monitoring
METRICS_COLLECTION_INTERVAL=30
BABEL_METRICS_PORT=33123
ALERT_LATENCY_THRESHOLD_MS=100
ALERT_NODE_DOWN_TIMEOUT_SEC=300

# Network Configuration
MESH_NETWORK_CIDR=10.0.0.0/16
MESH_INFRASTRUCTURE_CIDR=10.0.0.0/23
MESH_CLIENT_POOL_START=10.0.2.0
MAX_ROUTERS=508
CLIENTS_PER_ROUTER=126

# Image Builder
IMAGEBUILDER_PATH=/app/imagebuilder
OPENWRT_VERSION=23.05.2
FIRMWARE_STORAGE_PATH=/app/firmware
BUILD_TIMEOUT_SECONDS=1800

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/openmesh/app.log
